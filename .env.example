# Local development/review only; do not copy this mode into a Netlify deployment.
CONTENT_STORAGE=local

# Generate with: npm run hash-password
# Format: scrypt:<salt hex>:<hash hex>. Never store the plaintext password here.
ADMIN_PASSWORD_HASH=

# Use a random string of at least 32 characters. Keep this secret.
SESSION_SECRET=

# Local origins. Production APP_ORIGIN and SITE_URL must both be the actual
# canonical HTTPS origin, configured in Netlify's runtime environment settings.
APP_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000

# Production target: Netlify Free + Netlify Blobs. In Netlify's runtime
# environment settings, use CONTENT_STORAGE=netlify with the auth values above.
# Blobs credentials are provided automatically; no storage token is required.
# See docs/PUBLISHING.md. Runtime secrets do not belong in netlify.toml.
# Withhold production auth secrets from ordinary deploy previews. A deliberately
# writable preview needs separate secrets/origins and uses an isolated store.

# Optional Supabase adapter only; not required for Netlify Blobs.
# After a separately authorized setup, use CONTENT_STORAGE=supabase and run
# storage/pixelated.sql in that dedicated project. Leave these unset otherwise.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=pixelated-private

# Optional local-only data directory (default .data).
# PIXELATED_DATA_DIR=
