# Local review only. Vercel never uses local filesystem persistence.
CONTENT_STORAGE=local

# Generate with: npm run hash-password
# Format: scrypt:<salt hex>:<hash hex>. Never store the plaintext password here.
ADMIN_PASSWORD_HASH=

# Use a random string of at least 32 characters. Keep this secret.
SESSION_SECRET=

# Canonical public origin after an eligible hosting plan is configured.
SITE_URL=http://localhost:3000

# Production persistence: run storage/pixelated.sql in a dedicated Supabase project.
# Set CONTENT_STORAGE=supabase in the deployment environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pixelated-private

# Optional local-only data directory (default .data).
# PIXELATED_DATA_DIR=
